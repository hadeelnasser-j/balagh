# ==================================================
# BALAGH backend configuration
# Copy to backend/.env and fill in. Never commit .env.
# ==================================================

ENVIRONMENT=development
# Comma-separated list. localhost/127.0.0.1 on any port are always allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================================================
# Supabase: project & processing data
# ==================================================
# supabase = production; memory = in-process store for offline development only
DATA_BACKEND=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key: server-side only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Network timeout for Supabase calls; an unreachable project fails fast instead of hanging.
SUPABASE_TIMEOUT_SECONDS=10

# ==================================================
# Storage / buckets
# ==================================================
# Working media files (videos, audio, TTS, outputs) always live here:
STORAGE_DIR=./storage
# Also mirror every file to Supabase Storage buckets:
SUPABASE_STORAGE_ENABLED=false
BUCKET_VIDEOS=videos
BUCKET_AUDIO=audio
BUCKET_SUBTITLES=subtitles
BUCKET_OUTPUTS=dubbed-outputs

# ==================================================
# Local sources database (Quran / HadeethEnc)
# ==================================================
SOURCES_DB_PATH=./data/balagh_sources.sqlite3
QURAN_MATCH_THRESHOLD=0.92
HADITH_MATCH_THRESHOLD=0.85
# A source reference is attached ONLY at/above the thresholds above.
# Quran score in [QURAN_SUSPECT_THRESHOLD, QURAN_MATCH_THRESHOLD): "uncertain", Quran-protected, no reference.
QURAN_SUSPECT_THRESHOLD=0.85
# Quran/Hadith text inside longer speech counts only if the quoted source has at least this many
# normalized chars (or is a verbatim ayah of 3+ words, or follows "قال الله تعالى").
MIN_EMBEDDED_QUOTE_CHARS=25
CANDIDATE_THRESHOLD=0.70
# Hadith suggestions in "recover sources"; Quran suggestions also need QURAN_SUSPECT_THRESHOLD.
RECOVERY_THRESHOLD=0.70
MIN_MATCH_CHARS=12
# A source quoted inside longer speech covering less than this share -> uncertain (mixed)
MIXED_COVERAGE_THRESHOLD=0.85

# ==================================================
# FFmpeg
# ==================================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_SECONDS=900
AUDIO_SAMPLE_RATE=16000

# ==================================================
# AI providers: openai | gemini
# ==================================================
TRANSCRIPTION_PROVIDER=openai
TRANSLATION_PROVIDER=openai
TTS_PROVIDER=openai

# ---------- OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
# High-accuracy text model; each timed segment is re-transcribed with it.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Model that returns segment timestamps (verbose_json). Only whisper-1 supports this.
OPENAI_TIMESTAMP_MODEL=whisper-1
OPENAI_REFINE_SEGMENTS=true
OPENAI_TRANSLATION_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---------- Gemini
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

TRANSCRIPTION_LANGUAGE_HINT=ar
PROVIDER_TIMEOUT_SECONDS=120

# ==================================================
# Concurrency
# ==================================================
WORKER_THREADS=4
MAX_TRANSLATION_CONCURRENCY=3
MAX_TTS_CONCURRENCY=2

# ==================================================
# Translation / subtitles
# ==================================================
SRT_INCLUDE_ATTRIBUTION=true

# ==================================================
# TTS / audio rendering
# ==================================================
# Speed-up applied to a TTS clip to fit its slot. Longer clips are flagged "overflow" (a warning only).
DUBBING_MAX_TEMPO=1.35
# Approved audio is final: an overflowing approved clip is sped up at render time up to this factor and
# never blocks rendering. It never plays over Quran (original-audio) segments.
APPROVED_OVERFLOW_MAX_TEMPO=1.6
# Original speech volume under English TTS (0 = muted). Quran audio is never changed.
ORIGINAL_AUDIO_DUCK_VOLUME=0.0
DUBBED_AUDIO_BITRATE=192k
